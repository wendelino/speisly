---
// Ersetzt src/app/layout.tsx (Metadaten 1:1 übernommen)

import { Font } from "astro:assets";
import { PUBLIC_UMAMI_WEBSITE_ID } from "astro:env/client";
import Footer from "@/components/layout/footer.astro";
import "@/styles/globals.css";

type Props = {
  /** Seitentitel; wird zu "<title> | Speisly". Ohne Titel: "Speisly" */
  title?: string;
  description?: string;
  /** OpenGraph/Twitter; Default: die globalen Speisly-Werte */
  og?: {
    title?: string;
    description?: string;
    images?: { url: string; width?: number; height?: number; alt?: string }[];
  };
};

const DEFAULT_DESCRIPTION =
  "Aktuelle Speisepläne der Mensen der Martin-Luther-Universität Halle-Wittenberg";
const DEFAULT_OG_IMAGES = [
  { url: "/logo_512.png", width: 512, height: 512, alt: "Speisly Logo" },
];

const { title, description = DEFAULT_DESCRIPTION, og = {} } = Astro.props;
const fullTitle = title ? `${title} | Speisly` : "Speisly";
const ogTitle = og.title ?? "Speisly";
const ogDescription = og.description ?? DEFAULT_DESCRIPTION;
const ogImages = (og.images ?? DEFAULT_OG_IMAGES).map((img) => ({
  ...img,
  url: new URL(img.url, Astro.site).href,
}));
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <Font cssVariable="--font-geist-sans" preload/>
    <Font cssVariable="--font-geist-mono"/>
    <title>{fullTitle}</title>
    <meta name="description" content={description}>
    <meta name="author" content="Speisly">
    <link rel="manifest" href="/manifest.webmanifest">
    <meta
      name="keywords"
      content="Speiseplan,Mensa,MLU,Halle,Mensen,Essen,Speisly"
    >
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="Speisly">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta property="og:title" content={ogTitle}>
    <meta property="og:description" content={ogDescription}>
    {
      ogImages.map((img) => (
        <>
          <meta property="og:image" content={img.url} />
          {img.width && (
            <meta property="og:image:width" content={String(img.width)} />
          )}
          {img.height && (
            <meta property="og:image:height" content={String(img.height)} />
          )}
          {img.alt && <meta property="og:image:alt" content={img.alt} />}
        </>
      ))
    }
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content={ogTitle}>
    <meta name="twitter:description" content={ogDescription}>
    {ogImages.map((img) => <meta name="twitter:image" content={img.url} />)}
    <link rel="icon" href="/favicon.ico" sizes="128x128" type="image/x-icon">
    {
      import.meta.env.PROD && (
        <script
          is:inline
          data-website-id={PUBLIC_UMAMI_WEBSITE_ID}
          defer
          src="https://stats.speisly.de/script.js"
        />
      )
    }
  </head>
  <body class="relative flex min-h-screen flex-col antialiased">
    <slot/>
    <div class="flex-1"></div>
    <Footer/>
  </body>
</html>
