---

// Ersetzt src/app/(static)/layout.tsx: Container mit Zurück-Button
import type { ComponentProps } from "astro/types";
import BackButton from "@/components/layout/back-button.astro";
import BaseLayout from "./base-layout.astro";

type Props = ComponentProps<typeof BaseLayout>;
---

<BaseLayout {...Astro.props}>
  <div class="container mx-auto max-w-4xl p-3 pt-6">
    <BackButton />
    <div class="space-y-4 p-3"><slot /></div>
  </div>
</BaseLayout>
