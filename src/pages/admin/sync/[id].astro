---
// Admin: ein Sync-Lauf mit Änderungen, entfernten Ausgaben und Fehlern
import ChangeTable from "@/components/admin/change-table.astro";
import ErrorList from "@/components/admin/error-list.astro";
import StatusBadge from "@/components/admin/status-badge.astro";
import Card from "@/components/ui/card.astro";
import AdminLayout from "@/layouts/admin-layout.astro";
import { formatDateTime, formatDuration } from "@/lib/admin-format";
import { formatDay } from "@/lib/format";
import { getSyncRun } from "@/server/queries/admin";

export const prerender = false;

const detail = await getSyncRun(Astro.params.id ?? "");
if (!detail) {
  return new Response(null, { status: 404 });
}
const { run, changes, removals, errors } = detail;
const facts = [
  ["Scope", run.scope],
  ["Zeitraum", run.rangeFrom ? `${run.rangeFrom} – ${run.rangeTo}` : "–"],
  ["Start", formatDateTime(run.startedAt)],
  ["Dauer", formatDuration(run.durationMs)],
  ["Gerichte neu / geändert", `${run.newMeals} / ${run.changedMeals}`],
  [
    "Ausgaben neu / geändert / entfernt / behalten",
    `${run.newServings} / ${run.changedServings} / ${run.removedServings} / ${run.keptServings}`,
  ],
  ["Bilder neu / fehlgeschlagen", `${run.imagesCreated} / ${run.imagesFailed}`],
];
---

<AdminLayout title={`Lauf vom ${formatDateTime(run.startedAt)}`}>
  <Card class="mb-8">
    <div class="mb-4 flex flex-wrap items-center gap-2">
      <StatusBadge status={run.status} />
      {run.massRemoval && <span class="font-semibold text-rose text-sm">Notbremse gezogen</span>}
    </div>
    <dl class="grid gap-x-6 gap-y-3 text-sm sm:grid-cols-2">
      {
        facts.map(([label, value]) => (
          <div>
            <dt class="text-muted-foreground">{label}</dt>
            <dd class="font-semibold">{value}</dd>
          </div>
        ))
      }
    </dl>
    {run.error && <pre class="mt-4 overflow-auto rounded-xl bg-rose-soft p-3 text-rose text-xs">{run.error}</pre>}
  </Card>

  <h2 class="mb-3 font-bold font-display text-xl">Gerichtsänderungen ({changes.length})</h2>
  <div class="mb-8"><ChangeTable changes={changes} /></div>

  <h2 class="mb-3 font-bold font-display text-xl">Entfernte Ausgaben ({removals.length})</h2>
  {
    removals.length === 0 ? (
      <p class="mb-8 text-muted-foreground">Keine.</p>
    ) : (
      <ul class="mb-8 space-y-1 text-sm">
        {removals.map((r) => (
          <li>
            {formatDay(r.date, "EEE, dd.MM.yy")} · {r.mensaName ?? "Mensa unbekannt"} ·{" "}
            <a class="text-primary underline-offset-4 hover:underline" href={`/admin/meal/${r.mealId}`}>
              {r.mealName}
            </a>
          </li>
        ))}
      </ul>
    )
  }

  <h2 class="mb-1 font-bold font-display text-xl">Fehler ({errors.length})</h2>
  <p class="mb-3 text-muted-foreground text-sm">
    Fehler, die zuletzt in diesem Lauf aufgetreten sind.
  </p>
  <ErrorList errors={errors} />
</AdminLayout>
