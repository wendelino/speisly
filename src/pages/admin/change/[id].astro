---
// Admin: eine Gerichtsänderung oder entfernte Ausgabe mit Sync-Lauf und den
// Originaldaten des Gerichts aus den rohen API-Antworten dieses Laufs
import StatusBadge from "@/components/admin/status-badge.astro";
import Card from "@/components/ui/card.astro";
import AdminLayout from "@/layouts/admin-layout.astro";
import {
  CHANGE_LABEL,
  formatBytes,
  formatChangeValue,
  formatDateTime,
  formatDuration,
} from "@/lib/admin-format";
import { toIsoDay } from "@/lib/dates";
import { formatDay } from "@/lib/format";
import { getChangeDetail } from "@/server/queries/admin";

export const prerender = false;

const detail = await getChangeDetail(Astro.params.id ?? "");
if (!detail) {
  return new Response(null, { status: 404 });
}
const { change, removal, run, original } = detail;
const entry = (change ?? removal)!;
const day = (date: Date | string) =>
  formatDay(typeof date === "string" ? date : toIsoDay(date), "EEE, dd.MM.yy");
const LINK = "text-primary underline-offset-4 hover:underline";

const serving = change?.servingDate
  ? `${day(change.servingDate)} · ${change.mensaName}`
  : removal
    ? `${day(removal.date)} · ${removal.mensaName ?? "Mensa unbekannt"}`
    : null;
const facts: [string, string][] = [
  ["Art", CHANGE_LABEL[change ? change.field : "removed"]],
  ["Zeit", formatDateTime(entry.createdAt)],
  ["Quell-ID", entry.srcId],
  ...(serving ? [["Ausgabe", serving] as [string, string]] : []),
  ["ID", entry.id],
];
---

<AdminLayout title={`${CHANGE_LABEL[change ? change.field : "removed"]}: ${entry.mealName}`}>
  <Card class="mb-8">
    <dl class="grid gap-x-6 gap-y-3 text-sm sm:grid-cols-2">
      <div>
        <dt class="text-muted-foreground">Gericht</dt>
        <dd class="font-semibold">
          <a class={LINK} href={`/admin/meal/${entry.mealId}`}>{entry.mealName}</a>
        </dd>
      </div>
      {
        facts.map(([label, value]) => (
          <div>
            <dt class="text-muted-foreground">{label}</dt>
            <dd class="break-all font-semibold">{value}</dd>
          </div>
        ))
      }
    </dl>
    {
      change && (
        <p class="mt-4 text-sm">
          <span class="break-all text-muted-foreground line-through">
            {formatChangeValue(change.prev)}
          </span>{" "}
          → <span class="break-all font-semibold">{formatChangeValue(change.next)}</span>
        </p>
      )
    }
  </Card>

  <h2 class="mb-3 font-bold font-display text-xl">Sync-Lauf</h2>
  {
    run ? (
      <Card class="mb-8">
        <p class="mb-3 flex flex-wrap items-center gap-2 text-sm">
          <StatusBadge status={run.status} />
          <a class={`${LINK} font-semibold`} href={`/admin/sync/${run.id}`}>
            {formatDateTime(run.startedAt)} · {run.scope}
          </a>
          <span class="break-all text-muted-foreground">{run.id}</span>
        </p>
        {run.responses.length === 0 ? (
          <p class="text-muted-foreground text-sm">Keine API-Antworten gespeichert.</p>
        ) : (
          <ul class="space-y-1 text-sm">
            {run.responses.map((r) => (
              <li class="break-all">
                <span class={r.status >= 400 ? "font-semibold text-rose" : "font-semibold"}>{r.status}</span> ·{" "}
                {formatDuration(r.durationMs)} · {formatBytes(r.bytes)} ·{" "}
                <a class={LINK} href={`/admin/api-response/${r.id}`} target="_blank">
                  {r.url}
                </a>
              </li>
            ))}
          </ul>
        )}
      </Card>
    ) : (
      <p class="mb-8 text-muted-foreground">
        Kein Lauf gespeichert (Altdaten aus der Zeit vor dem Sync-Protokoll).
      </p>
    )
  }

  <h2 class="mb-1 font-bold font-display text-xl">Originaldaten</h2>
  <p class="mb-3 text-muted-foreground text-sm">
    Einträge des Gerichts in der API-Antwort dieses Laufs (<code>/food_plans</code>),
    unverändert.{removal && " Die entfernte Ausgabe selbst fehlt hier, deshalb wurde sie entfernt."}
  </p>
  {
    original === null ? (
      <p class="text-muted-foreground">
        Für diesen Lauf ist keine API-Antwort gespeichert.
      </p>
    ) : original.length === 0 ? (
      <p class="text-muted-foreground">Das Gericht kommt in der Antwort nicht vor.</p>
    ) : (
      <div class="space-y-4">
        {original.map((item) => (
          <div>
            <p class="mb-1 font-semibold text-sm">
              {day(item.date.slice(0, 10))} · {item.locationName ?? `Standort ${item.location_id}`}
            </p>
            <pre class="overflow-auto rounded-xl bg-muted/60 p-3 text-xs">{JSON.stringify(item, null, 2)}</pre>
          </div>
        ))}
      </div>
    )
  }
</AdminLayout>
