---
import { Mail } from "@lucide/astro";
import FormPage from "@/components/forms/form-page.astro";
import BackLayout from "@/layouts/back-layout.astro";
---

<BackLayout description="Fragen, Ideen oder einen Fehler entdeckt? Schreib uns." title="Kontakt">
  <FormPage
    heading="Schreib uns"
    intro="Fragen, Ideen oder ein Fehler entdeckt? Wir melden uns schnellstmöglich bei dir."
    tone="sky"
    variant="contact"
  >
    <Mail slot="icon" />
  </FormPage>
</BackLayout>
