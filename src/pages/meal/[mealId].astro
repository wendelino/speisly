---
// Detailseite eines Gerichts. Mit ?mmid= zeigt sie Mensa, Tag und Zutaten
// dieser Ausgabe und erlaubt das Bewerten, sonst die der neuesten Ausgabe.
// Bewertungen, Inhaltsstoffe und Angebotshistorie stehen in Tabs; die
// Angebotshistorie ist eine Server Island und wird separat geladen und gecacht.
import { CalendarDays, MapPin } from "@lucide/astro";
import {
  INGREDIENT_ICONS,
  type SpriteIconName,
} from "@/components/icons/sprite-icons";
import DietBadge from "@/components/meal/diet-badge.astro";
import IngredientsList from "@/components/meal/ingredients-list.astro";
import MealActions from "@/components/meal/meal-actions.astro";
import MealImage from "@/components/meal/meal-image.astro";
import PriceTiles from "@/components/meal/price-tiles.astro";
import ServingStatsSkeleton from "@/components/meal/serving-stats-skeleton.astro";
import CommentLikesScript from "@/components/rating/comment-likes-script.astro";
import RatingButtonScript from "@/components/rating/rating-button-script.astro";
import RatingSummary from "@/components/rating/rating-summary.astro";
import ServingStats from "@/components/server-islands/serving-stats.astro";
import Badge from "@/components/ui/badge.astro";
import Card from "@/components/ui/card.astro";
import TabPanel from "@/components/ui/tab-panel.astro";
import Tabs from "@/components/ui/tabs.astro";
import BackLayout from "@/layouts/back-layout.astro";
import { formatDay, formatDecimal, formatEuro } from "@/lib/format";
import { visibleIngredientTypes } from "@/lib/ingredients";
import { mealPolicy } from "@/server/cache-policy";
import {
  mealOgData,
  mealOgImageUrl,
  OG_HEIGHT,
  OG_WIDTH,
} from "@/server/og/meal-og-image";
import { findMeal } from "@/server/queries/meal";
import {
  getApprovedComments,
  getMealRatingStats,
  getRatingBreakdown,
} from "@/server/queries/ratings";

export const prerender = false;

const mealId = Astro.params.mealId as string;
const mmid = Astro.url.searchParams.get("mmid") || undefined;

const [meal, ratingStats, comments, breakdown] = await Promise.all([
  findMeal(mealId, mmid),
  getMealRatingStats(mealId),
  getApprovedComments(mealId),
  getRatingBreakdown(mealId),
]);
if (!meal) {
  return new Response(null, { status: 404 });
}
Astro.cache.set(mealPolicy(meal.id));

const euro = (cents: number) => `${formatEuro(cents)} €`;
// Beschreibung (auch og:description): Beilage, Preise, Bewertung nur wenn vorhanden
const ratingCountText =
  ratingStats.ratingCount === 1
    ? "1 Bewertung"
    : `${ratingStats.ratingCount} Bewertungen`;
const ratingText = ratingStats.avgRating.value
  ? ` Bewertung: ${formatDecimal(ratingStats.avgRating.value)} von 5 Sternen (${ratingCountText}).`
  : "";
const priceText = `Preise: Student*in ${euro(meal.priceStud)}, Mitarbeiter*in ${euro(meal.priceWork)}, Gast ${euro(meal.priceGuest)}.`;
// Beilage aus dem Untertitel („mit Pommes“ → „Mit Pommes.“)
const subtitle = meal.subtitle.trim();
const sideText = subtitle
  ? `${subtitle.charAt(0).toUpperCase()}${subtitle.slice(1)}${/[.!?]$/.test(subtitle) ? "" : "."} `
  : "";
const description = `${sideText}${priceText}${ratingText}`;
// Dynamisches OG-Bild mit Foto und aktueller Bewertung (src/server/og)
const images = [
  {
    url: mealOgImageUrl(meal.id, mealOgData(meal, ratingStats)),
    width: OG_WIDTH,
    height: OG_HEIGHT,
    alt: meal.name,
  },
];
// Sprite nur mit den Icons, die diese Seite zeigt (Badges, Platzhalter,
// Sterne der Bewertung, Ladeanzeige des Bewerten-Buttons)
const badgeTypes = visibleIngredientTypes(meal.flags);
const spriteIcons: SpriteIconName[] = [
  ...new Set(badgeTypes.map((type) => INGREDIENT_ICONS[type])),
  ...(meal.imgPath ? [] : (["chef-hat"] as const)),
  "star",
  "heart",
  ...(mmid ? (["loader-circle"] as const) : []),
];
// View Transition nur, wenn die Seite von einer Karte (mit ?mmid=) kommt
const vt = Boolean(mmid);
const servedOn = formatDay(meal.servedOn, "EEEE, d. MMMM");

const TABS = [
  { id: "bewertungen", label: "Bewertungen", count: ratingStats.ratingCount },
  {
    id: "inhaltsstoffe",
    label: "Inhaltsstoffe",
    short: "Zutaten",
    count: meal.ingredients.length,
  },
  { id: "angebote", label: "Angebotshistorie", short: "Historie" },
];
---

<BackLayout
  description={description}
  mealAssets={spriteIcons}
  og={{ title: meal.name, description, images }}
  title={meal.name}
  width="wide"
>
  {mmid && <RatingButtonScript slot="head" />}
  <CommentLikesScript />
  <article
    class="grid items-start gap-6 md:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] md:gap-10"
  >
    <MealImage
      alt={meal.name}
      class="shadow-soft"
      priority
      src={meal.imgPath}
      view="detail"
      vt={vt}
    />

    <div class="space-y-5">
      {
        mmid && (
          <p class="flex flex-wrap items-center gap-x-4 gap-y-1 text-muted-foreground text-sm">
            <span class="inline-flex items-center gap-1.5">
              <MapPin class="size-4 text-primary" />
              {meal.mensaName}
            </span>
            <span class="inline-flex items-center gap-1.5">
              <CalendarDays class="size-4 text-primary" />
              {servedOn}
            </span>
          </p>
        )
      }
      <h1
        class="font-extrabold text-3xl leading-tight sm:text-4xl"
        data-vt={vt ? "title" : undefined}
      >
        {`${meal.name} `}<span class="font-semibold text-muted-foreground">{meal.subtitle}</span>
      </h1>
      {
        badgeTypes.length > 0 && (
          <div class="flex flex-wrap gap-2" data-vt={vt ? "ingredients" : undefined}>
            {badgeTypes.map((type) => <DietBadge size="lg" type={type} />)}
          </div>
        )
      }
      <PriceTiles meal={meal} vt={vt} />
      <MealActions
        mealId={meal.id}
        text={`${meal.name} ${meal.subtitle}`.trim()}
        title={`${meal.name} | Speisly`}
      />
      {
        meal.extras.length > 0 && (
          <div>
            <h2 class="mb-2 font-semibold text-muted-foreground text-sm">Dazu gibt’s</h2>
            <ul class="flex flex-wrap gap-2">
              {meal.extras.map((extra) => (
                <li><Badge class="px-3 py-1 text-sm" tone="sun">{extra}</Badge></li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </article>

  <Tabs class="mt-8 md:mt-10" label="Details zum Gericht" tabs={TABS}>
    <Card padding="md">
      <TabPanel active id="bewertungen">
        <RatingSummary
          breakdown={breakdown}
          comments={comments}
          mealId={meal.id}
          mensaMealId={mmid}
          stats={ratingStats}
        />
      </TabPanel>
      <TabPanel id="inhaltsstoffe">
        <IngredientsList ingredients={meal.ingredients} />
      </TabPanel>
      <TabPanel id="angebote">
        <ServingStats mealId={meal.id} server:defer>
          <ServingStatsSkeleton slot="fallback" />
        </ServingStats>
      </TabPanel>
    </Card>
  </Tabs>
</BackLayout>
