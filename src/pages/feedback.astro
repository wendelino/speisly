---
import { MessageSquareHeart } from "@lucide/astro";
import FormPage from "@/components/forms/form-page.astro";
import BackLayout from "@/layouts/back-layout.astro";
---

<BackLayout
  description="Teilen Sie uns Ihr Feedback mit"
  title="Feedback"
  withToasts
>
  <FormPage
    heading="Wie gefällt dir Speisly?"
    intro="Erzähl uns, was dir gefällt oder was wir besser machen können. Alles bleibt anonym."
    tone="sun"
    variant="feedback"
  >
    <MessageSquareHeart slot="icon" />
  </FormPage>
</BackLayout>
