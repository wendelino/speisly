---
// „Jetzt bewerten“ / „Bewertung ändern“. Statisch gerendert; die Beschriftung
// je Zustand schaltet styles/components.css um, das Verhalten steckt in
// rating-button-script.astro (im <head> eingebunden). Die Seite
// braucht die Sprite-Icons "star" und "loader-circle".
import Icon from "@/components/icons/icon.astro";
import { buttonVariants } from "@/components/ui/variants";
import { cn } from "@/lib/utils";

type Props = { mealId: string; mensaMealId: string; class?: string };
const { mealId, mensaMealId, class: className } = Astro.props;

const classFor = (variant: "default" | "outline") =>
  cn(buttonVariants({ variant, size: "lg" }), "w-full", className);
---

<button
  aria-haspopup="dialog"
  class={classFor("default")}
  data-class-default={classFor("default")}
  data-class-outline={classFor("outline")}
  data-meal-id={mealId}
  data-mensa-meal-id={mensaMealId}
  data-rate-button="new"
  type="button"
><span data-rate-label="new"><Icon class="size-4 fill-current" name="star" />Jetzt bewerten</span><span data-rate-label="existing"><Icon class="size-4" name="star" />Bewertung ändern</span><span data-rate-label="loading"><Icon class="size-4 animate-spin" name="loader-circle" />Laden...</span></button>
