---
// Bewertungsübersicht der Detailseite (Tab „Bewertungen“). Teil der
// (gecachten) Seite; die Seite wird beim Bewerten über den Tag ratings:<id>
// invalidiert, der Bewerten-Button (zwischen Übersicht und Kommentaren) lädt alle
// [data-rating-summary]-Blöcke danach neu
// (rating-button-script.astro). Kommentare nur nach Freigabe im Admin; ihre
// Like-Buttons steuert comment-likes-script.astro.
// Die Seite braucht die Sprite-Icons "star", "heart" und "chevron-down".
// Die Aufschlüsselung nach Mensa/Ausgabe ist eingeklappt (<details>).
import Icon from "@/components/icons/icon.astro";
import Meter from "@/components/ui/meter.astro";
import Stars from "@/components/ui/stars.astro";
import { TIME_ZONE } from "@/lib/dates";
import { formatDay, formatDecimal } from "@/lib/format";
import RatingButton from "./rating-button.astro";

type Props = {
  mealId: string;
  stats: MealRatingStats;
  /** Bewertungen nach Mensa und Ausgabe (getRatingBreakdown) */
  breakdown?: MealRatingBreakdown;
  /** nur freigegebene Kommentare (getApprovedComments) */
  comments?: MealComment[];
  /** nur mit konkreter Ausgabe (`?mmid=`) kann bewertet werden */
  mensaMealId?: string;
};

const { mealId, stats, breakdown, comments = [], mensaMealId } = Astro.props;
const commentDate = (value: Date) =>
  value.toLocaleDateString("de-DE", {
    timeZone: TIME_ZONE,
    day: "numeric",
    month: "long",
    year: "numeric",
  });
const { ratingCount, avgRating } = stats;

const categories = [
  { label: "Preis-Leistung", value: avgRating.value_price },
  { label: "Menge", value: avgRating.value_quantity },
  { label: "Geschmack", value: avgRating.value_taste },
].filter(
  (item): item is { label: string; value: number } => item.value !== null
);

const plural = (n: number) => `${n} ${n === 1 ? "Bewertung" : "Bewertungen"}`;
// Aufschlüsselung nur, wenn es etwas zu vergleichen gibt
const byMensa = (breakdown?.byMensa.length ?? 0) > 1 ? breakdown?.byMensa : [];
const byServing =
  (breakdown?.servingCount ?? 0) > 1 ? breakdown?.byServing : [];
const hasBreakdown = (byMensa?.length ?? 0) > 0 || (byServing?.length ?? 0) > 0;
const breakdownHint = [
  (byMensa?.length ?? 0) > 0 && "Nach Mensa",
  (byServing?.length ?? 0) > 0 && "Letzte Ausgaben",
]
  .filter(Boolean)
  .join(" · ");
---

<div>
  <div data-rating-summary="stats">
    {
      ratingCount === 0 || avgRating.value === null ? (
        <div class="rounded-2xl bg-muted/60 p-5 text-center">
          <p class="font-display font-semibold">Noch keine Bewertungen</p>
          <p class="mt-1 text-muted-foreground text-sm">
            Schon probiert? Sag uns, wie’s geschmeckt hat!
          </p>
        </div>
      ) : (
        <div class="space-y-5">
          <div class="flex items-center gap-4">
            <p class="font-display font-extrabold text-5xl text-primary tabular-nums leading-none">
              {formatDecimal(avgRating.value)}
            </p>
            <div class="space-y-1">
              <Stars value={avgRating.value} />
              <p class="text-muted-foreground text-sm">
                {`aus ${plural(ratingCount)}`}
              </p>
            </div>
          </div>
          {categories.length > 0 && (
            <ul class="space-y-2.5">
              {categories.map((item) => (
                <li class="grid grid-cols-[7.5rem_1fr_2.25rem] items-center gap-3 text-sm">
                  <span class="text-muted-foreground">{item.label}</span>
                  <Meter tone="sun" value={item.value / 5} />
                  <span class="text-right font-bold font-display tabular-nums">{formatDecimal(item.value)}</span>
                </li>
              ))}
            </ul>
          )}
          {hasBreakdown && (
            <details class="group rounded-2xl ring-1 ring-border/70">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-3 rounded-2xl px-4 py-3 font-medium text-sm outline-none focus-visible:ring-[3px] focus-visible:ring-ring [&::-webkit-details-marker]:hidden">
                <span>
                  <span class="group-open:hidden">Mehr anzeigen</span>
                  <span class="hidden group-open:inline">Weniger anzeigen</span>
                  <span class="block font-normal text-muted-foreground text-xs">{breakdownHint}</span>
                </span>
                <Icon class="size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180" name="chevron-down" />
              </summary>
              <div class="space-y-5 px-4 pt-1 pb-4">
                {byMensa && byMensa.length > 0 && (
                  <section aria-labelledby="rating-by-mensa">
                    <h3 class="mb-2 font-display font-semibold text-sm" id="rating-by-mensa">
                      Nach Mensa
                    </h3>
                    <ul class="space-y-2.5">
                      {byMensa.map((item) => (
                        <li class="grid grid-cols-[7.5rem_1fr_2.25rem] items-center gap-3 text-sm">
                          <span class="truncate text-muted-foreground" title={item.mensaName}>
                            {item.mensaName}
                            <span class="sr-only">{`, ${plural(item.count)}`}</span>
                          </span>
                          <Meter tone="primary" value={item.value / 5} />
                          <span class="text-right font-bold font-display tabular-nums">{formatDecimal(item.value)}</span>
                        </li>
                      ))}
                    </ul>
                  </section>
                )}
                {byServing && byServing.length > 0 && (
                  <section aria-labelledby="rating-by-serving">
                    <h3 class="mb-2 font-display font-semibold text-sm" id="rating-by-serving">
                      Letzte Ausgaben
                    </h3>
                    <ul class="divide-y divide-border/70 rounded-2xl bg-muted/60 px-4">
                      {byServing.map((item) => (
                        <li class="flex items-center justify-between gap-3 py-2.5 text-sm">
                          <span class="min-w-0">
                            <span class="block font-medium">{formatDay(item.date, "EEE, d. MMM yyyy")}</span>
                            <span class="block truncate text-muted-foreground text-xs">
                              {`${item.mensaName} · ${plural(item.count)}`}
                            </span>
                          </span>
                          <span class="inline-flex shrink-0 items-center gap-1 font-bold font-display tabular-nums">
                            <Icon class="size-4 fill-gold text-gold" name="star" />
                            {formatDecimal(item.value)}
                          </span>
                        </li>
                      ))}
                    </ul>
                  </section>
                )}
              </div>
            </details>
          )}
        </div>
      )
    }
  </div>
  {mensaMealId && <RatingButton class="mt-5" mealId={mealId} mensaMealId={mensaMealId} />}
  <div data-meal-id={mealId} data-rating-summary="comments">
    {comments.length > 0 && (
      <section aria-labelledby="rating-comments" class="mt-6 border-border/70 border-t pt-5">
        <h3 class="mb-3 font-display font-semibold" id="rating-comments">
          Kommentare
        </h3>
        <p aria-live="polite" class="mb-3 rounded-xl bg-rose-soft px-3 py-2 text-rose text-sm" data-like-status hidden></p>
        <ul class="space-y-3">
          {comments.map((entry) => (
            <li class="rounded-2xl bg-muted/60 p-4">
              <div class="mb-1.5 flex flex-wrap items-center justify-between gap-2">
                <Stars size="sm" value={entry.value} />
                <time class="text-muted-foreground text-xs" datetime={entry.updatedAt.toISOString()}>
                  {commentDate(entry.updatedAt)}
                </time>
              </div>
              <p class="whitespace-pre-line break-words text-sm leading-relaxed">{entry.comment}</p>
              <div class="mt-2 flex justify-end">
                <button
                  aria-label="Gefällt mir"
                  aria-pressed="false"
                  class="c-like"
                  data-like={entry.id}
                  data-likes={entry.likes}
                  type="button"
                ><Icon class="size-4" name="heart" /><span data-like-count>{entry.likes > 0 ? entry.likes : ""}</span></button>
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</div>
