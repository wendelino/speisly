---
import { SearchX } from "@lucide/astro";
// Astro-Port von empty-state.tsx. Der „Filter zurücksetzen“-Button wird
// über data-filter-reset vom Filter-Script angebunden.
import type { HTMLAttributes } from "astro/types";
import { buttonVariants } from "@/components/ui/button";
import { formatIsoDay } from "@/lib/format-day";
import { cn } from "@/lib/utils";

type Props = HTMLAttributes<"div"> & {
  type?: "date" | "filter";
  /** `YYYY-MM-DD` (nur für type="date") */
  date?: string;
  /** heutiges Datum in Berlin, für „Heute“/„Morgen“ */
  today?: string;
};

const { type = "date", date, today, class: className, ...rest } = Astro.props;

const title = "Keine Gerichte gefunden";
let description: string;
if (type === "filter") {
  description =
    "Es wurden keine Gerichte gefunden, die den aktuellen Filtern entsprechen.";
} else if (date && today) {
  description = `Keine Gerichte für ${formatIsoDay(date, today, "EEEE, dd.MM.yy")} verfügbar.`;
} else {
  description = "Keine Gerichte verfügbar.";
}
---

<div
  class={cn(
    "flex min-h-[75vh] flex-col items-center justify-center px-4 py-32",
    className
  )}
  {...rest}
>
  <div class="relative mb-6">
    <div
      class="absolute inset-0 animate-pulse rounded-full bg-muted opacity-50 blur-2xl"
    >
    </div>
    <div class="relative rounded-full border border-border/50 bg-muted/50 p-3">
      <SearchX class="h-12 w-12 text-primary" />
    </div>
  </div>

  <div class="max-w-md space-y-3 text-center">
    <h3 class="font-semibold text-2xl text-foreground">{title}</h3>
    <p class="text-base text-muted-foreground leading-relaxed">{description}</p>
    {
      type === "filter" && (
        <button
          class={cn(buttonVariants({ variant: "outline" }))}
          data-filter-reset
          data-slot="button"
          type="button"
        >
          Filter zurücksetzen
        </button>
      )
    }
  </div>
</div>
