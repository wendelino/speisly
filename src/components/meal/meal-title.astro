---
// Astro-Port von MealTitle (meal-comp.tsx)
import Title from "@/components/astro/title.astro";

type Props = {
  name: string;
  subtitle: string;
  h1?: boolean;
  /** Teil der View Transition (lib/view-transitions.ts) */
  vt?: boolean;
};

const { name, subtitle, h1 = false, vt: inTransition = false } = Astro.props;
const text = `${name} ${subtitle}`;
const vt = inTransition ? "title" : undefined;
---

{
  h1 ? (
    <Title class="mt-0" data-vt={vt} noBorder variant="h1">
      {text}
    </Title>
  ) : (
    // = <Title variant="h4" noBorder class="my-0 line-clamp-2 …"> (meal.css)
    <h4 class="m-title" data-vt={vt}>{text}</h4>
  )
}
