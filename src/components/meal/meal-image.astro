---
// Astro-Port von MealImage (meal-comp.tsx). Skeleton + Einblenden per CSS;
// `data-loaded` setzt ein einziger Load-Listener im <head> (lib/meal-assets.ts)
// statt onload/onerror an jedem Bild.
// Klassen m-*: src/styles/meal.css.
// Bilder: vorberechnete Varianten aus dem Sync (src/server/images), AVIF per
// <source>, WebP als Fallback im <img>; ohne Varianten das Original.
import Icon from "@/components/icons/icon.astro";
import { cn } from "@/lib/utils";
import { images } from "@/server/images";

/**
 * Karte: Bild = erste von drei Spalten der Karte (gemessen ~90 px auf dem
 * Handy, ~105 px auf dem Desktop), siehe meal-card.astro
 */
const CARD_SIZES = "(max-width: 768px) 30vw, 160px";

type Props = {
  src?: string | null;
  alt: string;
  class?: string;
  priority?: boolean;
  view?: "card" | "detail";
  sizes?: string;
  /** Teil der View Transition (lib/view-transitions.ts) */
  vt?: boolean;
};

const {
  src,
  alt,
  class: className,
  priority = false,
  view = "card",
  sizes = CARD_SIZES,
  vt = false,
} = Astro.props;
const variants = src ? images.variants(src) : null;
---

<div
  class={
    view === "card"
      ? "m-img"
      : cn(
          "relative aspect-4/3 overflow-hidden rounded-lg transition-all duration-300",
          className
        )
  }
  data-meal-image
  data-vt={vt ? "image" : undefined}
>
  {
    src ? (
      <>
        <div class="m-skel" />
        <picture class="contents">
          {variants && (
            <source sizes={sizes} srcset={variants.srcset.avif} type="image/avif" />
          )}
        <img
          alt={alt}
          class="m-photo"
          data-meal-img
          decoding="async"
          fetchpriority={priority ? "high" : undefined}
          height="375"
          loading={priority ? "eager" : "lazy"}
          sizes={variants ? undefined : sizes}
          src={variants?.src ?? src}
          width="500"
        />
        </picture>
      </>
    ) : (
      <div class="m-noimg">
        <Icon
          class={cn("size-16 text-border", view === "detail" ? "size-32" : "")}
          name="image-off"
        />
      </div>
    )
  }
</div>

<style is:global>
  img[data-meal-img]:not([data-loaded]) {
    opacity: 0;
  }
  [data-meal-image]:has(img[data-loaded]) > .m-skel {
    display: none;
  }
</style>
