---
// Astro-Port von MealImage (meal-comp.tsx). Skeleton + Einblenden per CSS,
// der Ladezustand kommt über ein Inline-onload statt React-State.
// Bilder: vorberechnete AVIF/WebP-Varianten aus dem Sync (src/server/images),
// solange es keine gibt, das Original von meine-mensa.de.
import { ImageOff } from "@lucide/astro";
import { cn } from "@/lib/utils";
import { images } from "@/server/images";

/**
 * Karte: Bild = erste von drei Spalten der Karte (gemessen ~90 px auf dem
 * Handy, ~105 px auf dem Desktop), siehe meal-card.astro
 */
const CARD_SIZES = "(max-width: 768px) 30vw, 160px";

type Props = {
  src?: string | null;
  alt: string;
  class?: string;
  priority?: boolean;
  view?: "card" | "detail";
  sizes?: string;
  /** für View Transitions (lib/view-transitions.ts) */
  vtId?: string;
};

const {
  src,
  alt,
  class: className,
  priority = false,
  view = "card",
  sizes = CARD_SIZES,
  vtId,
} = Astro.props;
const variants = src ? images.variants(src) : null;
---

<div
  class={cn(
    "relative aspect-4/3 overflow-hidden rounded-lg transition-all duration-300",
    className
  )}
  data-meal-image
  data-vt={vtId ? `meal-image-${vtId}` : undefined}
>
  {
    src ? (
      <>
        <div
          class={cn(
            "animate-pulse rounded-md bg-accent",
            "absolute inset-0 h-full w-full rounded-lg"
          )}
          data-slot="skeleton"
        />
        <picture class="contents">
          {variants && (
            <source sizes={sizes} srcset={variants.srcset.avif} type="image/avif" />
          )}
          {variants && (
            <source sizes={sizes} srcset={variants.srcset.webp} type="image/webp" />
          )}
        <img
          alt={alt}
          class="h-full w-full object-contain transition-opacity duration-300"
          data-meal-img
          decoding="async"
          fetchpriority={priority ? "high" : "auto"}
          height="375"
          loading={priority ? "eager" : "lazy"}
          onerror="this.dataset.loaded=''"
          onload="this.dataset.loaded=''"
          sizes={variants ? undefined : sizes}
          src={variants?.src ?? src}
          width="500"
        />
        </picture>
      </>
    ) : (
      <div class="flex h-full w-full items-center justify-center rounded-lg border border-border/30 bg-muted/50">
        <ImageOff
          class={cn("size-16 text-border", view === "detail" ? "size-32" : "")}
        />
      </div>
    )
  }
</div>

<style is:global>
  img[data-meal-img]:not([data-loaded]) {
    opacity: 0;
  }
  [data-meal-image]:has(img[data-loaded]) > [data-slot="skeleton"] {
    display: none;
  }
</style>
