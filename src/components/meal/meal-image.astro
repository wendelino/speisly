---
// Gerichtsbild mit Skeleton. `data-loaded` setzt ein einziger Load-Listener im
// <head> (lib/meal-assets.ts) statt onload/onerror an jedem Bild.
// Bilder: vorberechnete Varianten aus dem Sync (src/server/images), feste URL
// je Ansicht (Karte klein, Detail groß), AVIF per <source>, WebP als Fallback
// im <img>; ohne Varianten das Original. Ohne Bild: Kochmützen-Platzhalter.
// Klassen m-*: src/styles/meal.css. Die Seite braucht das Sprite-Icon
// "chef-hat", wenn Gerichte ohne Bild vorkommen.
import Icon from "@/components/icons/icon.astro";
import { cn } from "@/lib/utils";
import { images } from "@/server/images";

type Props = {
  src?: string | null;
  alt: string;
  class?: string;
  priority?: boolean;
  view?: "card" | "detail";
  /** Teil der View Transition (lib/view-transitions.ts) */
  vt?: boolean;
};

const {
  src,
  alt,
  class: className,
  priority = false,
  view = "card",
  vt = false,
} = Astro.props;
const variants = src ? images.variants(src) : null;
const urls = variants?.[view === "card" ? "small" : "large"];
---

<div
  class={view === "card" ? "m-img" : cn("m-img aspect-4/3 rounded-3xl", className)}
  data-meal-image
  data-vt={vt ? "image" : undefined}
>
  {
    src ? (
      <>
        <div class="m-skel" />
        <picture class="contents">
          {urls && <source srcset={urls.avif} type="image/avif" />}
          <img alt={alt} class="m-photo" data-meal-img decoding="async" fetchpriority={priority ? "high" : undefined} height="375" loading={priority ? "eager" : "lazy"} src={urls?.webp ?? src} width="500" />
        </picture>
      </>
    ) : (
      <div class="m-noimg">
        <Icon class={view === "detail" ? "size-24 -rotate-12" : "size-10 -rotate-12"} name="chef-hat" />
      </div>
    )
  }
</div>

<style is:global>
  img[data-meal-img]:not([data-loaded]) {
    opacity: 0;
  }
  [data-meal-image]:has(img[data-loaded]) > .m-skel {
    display: none;
  }
</style>
