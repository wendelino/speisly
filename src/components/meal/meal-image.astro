---
// Astro-Port von MealImage (meal-comp.tsx). Skeleton + Einblenden per CSS;
// `data-loaded` setzt ein einziger Load-Listener im <head> (lib/meal-assets.ts)
// statt onload/onerror an jedem Bild.
// Klassen m-*: src/styles/meal.css.
// Bilder: vorberechnete Varianten aus dem Sync (src/server/images), feste URL
// je Ansicht (Karte klein, Detail groß), AVIF per <source>, WebP als Fallback
// im <img>; ohne Varianten das Original.
// Detailseite mit View Transition: Darunter liegt das Kartenbild als
// Platzhalter. Seine URL steht nur in `data-meal-lowres`, `src` setzt
// lib/view-transitions.ts erst, wenn man per Transition von der Liste kommt
// (dann liegt es im Cache). Direktaufrufe laden so nur das große Bild.
import Icon from "@/components/icons/icon.astro";
import { cn } from "@/lib/utils";
import { images } from "@/server/images";

type Props = {
  src?: string | null;
  alt: string;
  class?: string;
  priority?: boolean;
  view?: "card" | "detail";
  /** Teil der View Transition (lib/view-transitions.ts) */
  vt?: boolean;
};

const {
  src,
  alt,
  class: className,
  priority = false,
  view = "card",
  vt = false,
} = Astro.props;
const isCard = view === "card";
const variants = src ? images.variants(src) : null;
const urls = variants ? (isCard ? variants.small : variants.large) : null;
const lowRes = !isCard && vt && variants ? variants.small.avif : undefined;
---

<div
  class={
    isCard
      ? "m-img"
      : cn("relative aspect-4/3 overflow-hidden rounded-lg", className)
  }
  data-meal-image
  data-vt={vt ? "image" : undefined}
>
  {
    src ? (
      <>
        <div class="m-skel" />
        {lowRes && (
          <img
            alt=""
            aria-hidden="true"
            class="m-lowres"
            data-meal-lowres={lowRes}
            decoding="sync"
            height="375"
            width="500"
          />
        )}
        <picture class="contents">
          {urls && <source srcset={urls.avif} type="image/avif" />}
        <img
          alt={alt}
          class={lowRes ? "m-photo relative" : "m-photo"}
          data-meal-img
          decoding="async"
          fetchpriority={priority ? "high" : undefined}
          height="375"
          loading={priority ? "eager" : "lazy"}
          src={urls?.webp ?? src}
          width="500"
        />
        </picture>
      </>
    ) : (
      <div class="m-noimg">
        <Icon
          class={cn("size-16 text-border", isCard ? "" : "size-32")}
          name="image-off"
        />
      </div>
    )
  }
</div>

<style is:global>
  img[data-meal-img]:not([data-loaded]) {
    opacity: 0;
  }
  [data-meal-image]:has(img[data-loaded], img[data-meal-lowres][src])
    > .m-skel {
    display: none;
  }
</style>
