---
// Gerichtsbild. Das Bild ist nie ausgeblendet: Aus dem Cache steht es sofort
// da, ohne Ein- und Ausblenden beim Seitenwechsel. Nur wenn es nach 300 ms
// noch lädt, pulsiert ein Skeleton (meal.css .m-photo); `data-loaded` setzt
// ein einziger Load-Listener im <head> (lib/meal-assets.ts).
// Bilder: vorberechnete Varianten aus dem Sync (src/server/images), feste URL
// je Ansicht (Karte klein, Detail groß), nur WebP; ohne Varianten das
// Original. Lädt eine Variante nicht (WebP war in einzelnen iOS-Versionen im
// Blockierungsmodus kaputt), lädt das Boot-Script das Original aus
// `data-fallback`. Ohne Bild: Kochmützen-Platzhalter.
// Klassen m-*: src/styles/meal.css. Die Seite braucht das Sprite-Icon
// "chef-hat", wenn Gerichte ohne Bild vorkommen.
import Icon from "@/components/icons/icon.astro";
import { cn } from "@/lib/utils";
import { images } from "@/server/images";

type Props = {
  src?: string | null;
  alt: string;
  class?: string;
  priority?: boolean;
  view?: "card" | "detail";
  /** Teil der View Transition (lib/view-transitions.ts) */
  vt?: boolean;
};

const {
  src,
  alt,
  class: className,
  priority = false,
  view = "card",
  vt = false,
} = Astro.props;
const variants = src ? images.variants(src) : null;
const url = variants?.[view === "card" ? "small" : "large"];
---

<div
  class={view === "card" ? "m-img" : cn("m-img m-img-lg rounded-3xl", className)}
  data-vt={vt ? "image" : undefined}
>
  {
    src ? (
      <img alt={alt} class="m-photo" data-fallback={url ? src : undefined} decoding={priority ? "sync" : "async"} fetchpriority={priority ? "high" : undefined} height="375" loading={priority ? "eager" : "lazy"} src={url ?? src} width="500" />
    ) : (
      <div class="m-noimg">
        <Icon class={view === "detail" ? "size-24 -rotate-12" : "size-10 -rotate-12"} name="chef-hat" />
      </div>
    )
  }
</div>
