---
// Statische Variante von IngredientBadge (variant="default")
import Icon from "@/components/icons/icon.astro";
import { INGREDIENT_ICONS } from "@/components/icons/sprite-icons";
import { INGREDIENT_LABELS, type IngredientType } from "@/lib/ingredients";

type Props = { type: IngredientType };


const { type } = Astro.props;
const label = INGREDIENT_LABELS[type];
const icon = INGREDIENT_ICONS[type];
---

<button class={`ib ib-${type}`} type="button"><Icon class="size-3.5" name={icon} /> {label} </button>
