---
// „Jetzt bewerten“ / „Bewertung aktualisieren“ (vorher MealRatingDialog-Trigger).
// Statisch gerendert; das Verhalten steckt in rating-button-script.astro, das
// im <head> eingebunden wird (ein <script> hier wäre ein zusätzliches Kind der
// Box und würde die space-y-Abstände verändern).
import { LoaderCircle, Star } from "@lucide/astro";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";

type Props = { mealId: string; mensaMealId: string };
const { mealId, mensaMealId } = Astro.props;

// wie LoadingButton → Button mit className "w-full flex-1 gap-2"
const classFor = (variant: "default" | "outline") =>
  cn(buttonVariants({ variant, className: "w-full flex-1 gap-2" }));
---

<button
  aria-expanded="false"
  aria-haspopup="dialog"
  class={classFor("default")}
  data-class-default={classFor("default")}
  data-class-outline={classFor("outline")}
  data-meal-id={mealId}
  data-mensa-meal-id={mensaMealId}
  data-rate-button="new"
  data-slot="dialog-trigger"
  data-state="closed"
  type="button"
><span data-rate-label="new"><Star class="h-4 w-4" />Jetzt bewerten</span><span data-rate-label="existing"><Star class="h-4 w-4" />Bewertung aktualisieren</span><span data-rate-label="loading"><LoaderCircle class="size-4 animate-spin" />Laden...</span></button>

<style is:global>
  /* Spans sind layout-neutral: Icon und Text stehen wie bisher direkt im Button */
  [data-rate-label] {
    display: contents;
  }
  [data-rate-button="new"] [data-rate-label]:not([data-rate-label="new"]),
  [data-rate-button="existing"] [data-rate-label]:not([data-rate-label="existing"]),
  [data-rate-button="loading"] [data-rate-label]:not([data-rate-label="loading"]) {
    display: none;
  }
</style>
