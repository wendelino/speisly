---
/**
 * Speiseplan eines Tages, gruppiert nach Mensa. Statisches HTML für alle
 * Besucher (cachebar); die Filter wirken rein per CSS (lib/filters/boot.ts):
 *  - Mensa-Auswahl: generiertes CSS auf [data-mensa-id]
 *  - vegetarisch/vegan: html[data-diet] blendet [data-meal] ohne Flag aus.
 * Alles, was vom Ernährungsfilter abhängt (Hinweise „X Gerichte ausgeblendet“,
 * Zähler, leere Bereiche), wird hier für jede Variante vorberechnet und über
 * data-only-diet / data-hide-diet umgeschaltet – ohne JS und ohne Flackern.
 */
import Icon from "@/components/icons/icon.astro";
import { TONES, toneAt } from "@/components/ui/tones";
import Note from "@/components/ui/note.astro";
import { cn } from "@/lib/utils";
import EmptyState from "./empty-state.astro";
import MealCard from "./meal-card.astro";

type Props = {
  groups: MensaMealGroup[];
  /** angezeigter Tag (`YYYY-MM-DD`) */
  date: string;
  /** heute in Berlin (`YYYY-MM-DD`) */
  today: string;
};

type Diet = "veggie" | "vegan";
const DIETS: Diet[] = ["veggie", "vegan"];
const keeps = (meal: Meal, diet: Diet) =>
  diet === "vegan" ? Boolean(meal.flags.isVegan) : Boolean(meal.flags.isVeggie);

const { groups, date, today } = Astro.props;

const hiddenText = (n: number) =>
  `${n === 1 ? "1 Gericht wurde" : `${n} Gerichte wurden`} durch den Filter ausgeblendet.`;
const dietList = (pred: (d: Diet) => boolean) =>
  DIETS.filter(pred).join(" ") || undefined;

const prepared = groups.map((group, index) => {
  const regular = group.meals
    .filter((m) => !m.flags.isSmall)
    .sort((a, b) => b.priceStud - a.priceStud);
  const portion = group.meals.filter((m) => m.flags.isSmall);
  const stats = Object.fromEntries(
    DIETS.map((diet) => {
      const kept = group.meals.filter((m) => keeps(m, diet)).length;
      return [
        diet,
        {
          kept,
          hidden: group.meals.length - kept,
          regular: regular.filter((m) => keeps(m, diet)).length,
          portion: portion.filter((m) => keeps(m, diet)).length,
        },
      ];
    })
  ) as Record<
    Diet,
    { kept: number; hidden: number; regular: number; portion: number }
  >;
  return { group, regular, portion, stats, tone: TONES[toneAt(index)] };
});
---

{
  groups.length === 0 ? (
    <EmptyState date={date} today={today} type="date" />
  ) : (
    <>
      <div class="container-page space-y-8 pt-2 pb-8 md:pt-6" id="mealslist">
        {prepared.map(({ group, regular, portion, stats, tone }) => (
          <section
            aria-labelledby={`mensa-${group.slug}-title`}
            class="scroll-mt-2 md:scroll-mt-40"
            data-mensa-group
            data-mensa-id={group.id}
            id={`mensa-${group.slug}`}
          >
            <div class="m-head">
              <span class={cn("size-3 shrink-0 rounded-full", tone.solid)} />
              <h2 class="truncate font-bold text-xl sm:text-2xl" id={`mensa-${group.slug}-title`}>
                {group.name}
              </h2>
              <span class="m-count">
                <span data-hide-diet="veggie vegan">{group.meals.length}</span>
                {DIETS.map((d) => (
                  <span data-only-diet={d}>{stats[d].kept}</span>
                ))}
                <span class="sr-only"> Gerichte</span>
              </span>
            </div>
            <div class="flex flex-col gap-4">
              {DIETS.filter((d) => stats[d].hidden > 0).map((d) => (
                <Note data-only-diet={d}>{hiddenText(stats[d].hidden)}</Note>
              ))}
              {regular.length > 0 && (
                <div
                  class="m-grid"
                  data-hide-diet={dietList((d) => stats[d].regular === 0)}
                >
                  {regular.map((meal, index) => (
                    <MealCard meal={meal} priority={index < 3} />
                  ))}
                </div>
              )}
              {portion.length > 0 && (
                <details
                  class="m-more"
                  data-hide-diet={dietList((d) => stats[d].portion === 0)}
                >
                  <summary>
                    <span>Weitere Gerichte</span>
                    <span class="m-count bg-card">
                      <span data-hide-diet="veggie vegan">{portion.length}</span>
                      {DIETS.map((d) => (
                        <span data-only-diet={d}>{stats[d].portion}</span>
                      ))}
                    </span>
                    <span class="hidden font-normal font-sans text-muted-foreground text-xs sm:inline">
                      Buffet &amp; kleine Portionen
                    </span>
                    <Icon
                      class="m-chev ml-auto size-4 text-muted-foreground transition-transform duration-300"
                      name="chevron-down"
                    />
                  </summary>
                  <div class="m-grid p-1.5 pt-2">
                    {portion.map((meal) => (
                      <MealCard meal={meal} />
                    ))}
                  </div>
                </details>
              )}
            </div>
          </section>
        ))}
      </div>
      <div data-filter-empty>
        <EmptyState type="filter" />
      </div>
    </>
  )
}

<style is:global>
  html[data-diet="veggie"] [data-meal]:not([data-veggie]),
  html[data-diet="vegan"] [data-meal]:not([data-vegan]),
  html[data-diet="veggie"] [data-hide-diet~="veggie"],
  html[data-diet="vegan"] [data-hide-diet~="vegan"] {
    display: none !important;
  }
  [data-only-diet],
  [data-filter-empty] {
    display: none;
  }
  /* revert-layer: zurück auf die Utility-Klassen des Elements (z. B. flex) */
  html[data-diet="veggie"] [data-only-diet="veggie"],
  html[data-diet="vegan"] [data-only-diet="vegan"] {
    display: revert-layer;
  }
</style>

<script>
  import { setSelectedMensen } from "@/stores/filters";

  document.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).closest("[data-filter-reset]")) {
      setSelectedMensen([]);
    }
  });
</script>
