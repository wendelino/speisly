---
/**
 * Speiseplan eines Tages, gruppiert nach Mensa. Statisches HTML für alle
 * Besucher (cachebar); die Filter wirken rein per CSS (lib/filters/boot.ts):
 *  - Mensa-Auswahl: generiertes CSS auf [data-mensa-id]
 *  - vegetarisch/vegan: html[data-diet] blendet [data-meal] ohne Flag aus.
 *  - Allergene: generiertes CSS auf [data-allergens] der Karten; die Zähler
 *    verschwinden dann (sie kennen die Auswahl nicht).
 * Zähler und leere Bereiche je Ernährungsform werden hier für jede Variante
 * vorberechnet und über data-only-diet / data-hide-diet umgeschaltet
 * (styles/components.css) – ohne JS und ohne Flackern.
 * Der Hinweis „X Gerichte ausgeblendet“ je Mensa (hidden-meals-note.astro)
 * hängt auch von der Allergen-Auswahl ab: Den füllt lib/filters/boot.ts,
 * angestoßen vom Inline-Script direkt nach der Liste (vor dem ersten Paint).
 * Dabei werden auch Bereiche ohne sichtbares Gericht ausgeblendet
 * (data-meal-block). data-show-all an einer Mensa hebt die Filter dort auf.
 */
import Icon from "@/components/icons/icon.astro";
import HiddenMealsNote from "./hidden-meals-note.astro";
import MealCard from "./meal-card.astro";
import NoMeals from "./no-meals.astro";

type Props = {
  groups: MensaMealGroup[];
  /** angezeigter Tag (`YYYY-MM-DD`) */
  date: string;
  /** heute in Berlin (`YYYY-MM-DD`) */
  today: string;
};

type Diet = "veggie" | "vegan";
const DIETS: Diet[] = ["veggie", "vegan"];
const keeps = (meal: Meal, diet: Diet) =>
  diet === "vegan" ? Boolean(meal.flags.isVegan) : Boolean(meal.flags.isVeggie);

const { groups, date, today } = Astro.props;

const dietList = (pred: (d: Diet) => boolean) =>
  DIETS.filter(pred).join(" ") || undefined;

/**
 * Position jedes Gerichts je Sortierung (CSS `order`, meal.css). Die
 * Reihenfolge im HTML bleibt der Standard; Bewertung: beste zuerst,
 * unbewertete zuletzt, bei Gleichstand mehr Bewertungen zuerst.
 */
function sortOrders(meals: Meal[]) {
  const rank = (sorted: Meal[]) =>
    new Map(sorted.map((meal, index) => [meal.mensaMealId, index]));
  const priceAsc = rank([...meals].sort((a, b) => a.priceStud - b.priceStud));
  const priceDesc = rank([...meals].sort((a, b) => b.priceStud - a.priceStud));
  const rating = rank(
    [...meals].sort(
      (a, b) =>
        (b.rating?.value ?? -1) - (a.rating?.value ?? -1) ||
        (b.rating?.count ?? 0) - (a.rating?.count ?? 0)
    )
  );
  return (meal: Meal) => ({
    priceAsc: priceAsc.get(meal.mensaMealId) ?? 0,
    priceDesc: priceDesc.get(meal.mensaMealId) ?? 0,
    rating: rating.get(meal.mensaMealId) ?? 0,
  });
}

const prepared = groups.map((group) => {
  const regular = group.meals
    .filter((m) => !m.flags.isSmall)
    .sort((a, b) => b.priceStud - a.priceStud);
  const portion = group.meals.filter((m) => m.flags.isSmall);
  const stats = Object.fromEntries(
    DIETS.map((diet) => {
      const kept = group.meals.filter((m) => keeps(m, diet)).length;
      return [
        diet,
        {
          kept,
          regular: regular.filter((m) => keeps(m, diet)).length,
          portion: portion.filter((m) => keeps(m, diet)).length,
        },
      ];
    })
  ) as Record<
    Diet,
    { kept: number; regular: number; portion: number }
  >;
  return {
    group,
    regular,
    portion,
    stats,
    regularOrder: sortOrders(regular),
    portionOrder: sortOrders(portion),
  };
});
---

{
  groups.length === 0 ? (
    <NoMeals date={date} today={today} type="date" />
  ) : (
    <>
      <div class="container-page space-y-8 pt-2 pb-8 md:pt-6" id="mealslist">
        {prepared.map(({ group, regular, portion, stats, regularOrder, portionOrder }) => (
          <section
            aria-labelledby={`${group.slug}-title`}
            class="scroll-mt-16 md:scroll-mt-40"
            data-mensa-group
            data-mensa-id={group.id}
            id={group.slug}
          >
            <div class="m-head">
              <h2 class="truncate font-bold text-xl sm:text-2xl" id={`${group.slug}-title`}>
                {group.name}
              </h2>
              <span class="m-count">
                <span data-hide-diet="veggie vegan">{group.meals.length}</span>
                {DIETS.map((d) => (
                  <span data-only-diet={d}>{stats[d].kept}</span>
                ))}
                <span class="sr-only"> Gerichte</span>
              </span>
            </div>
            <div class="flex flex-col gap-4">
              <HiddenMealsNote />
              {regular.length > 0 && (
                <div
                  class="m-grid"
                  data-meal-block
                  data-hide-diet={dietList((d) => stats[d].regular === 0)}
                >
                  {regular.map((meal, index) => (
                    <MealCard meal={meal} order={regularOrder(meal)} priority={index < 3} />
                  ))}
                </div>
              )}
              {portion.length > 0 && (
                <details
                  class="m-more"
                  data-meal-block
                  data-hide-diet={dietList((d) => stats[d].portion === 0)}
                >
                  <summary>
                    <span>Weitere Gerichte</span>
                    <span class="m-count bg-card">
                      <span data-hide-diet="veggie vegan">{portion.length}</span>
                      {DIETS.map((d) => (
                        <span data-only-diet={d}>{stats[d].portion}</span>
                      ))}
                    </span>
                    <span class="hidden font-normal font-sans text-muted-foreground text-xs sm:inline">
                      Buffet &amp; kleine Portionen
                    </span>
                    <Icon
                      class="m-chev ml-auto size-4 text-muted-foreground transition-transform duration-300"
                      name="chevron-down"
                    />
                  </summary>
                  <div class="m-grid p-1.5 pt-2">
                    {portion.map((meal) => (
                      <MealCard meal={meal} order={portionOrder(meal)} />
                    ))}
                  </div>
                </details>
              )}
            </div>
          </section>
        ))}
      </div>
      {/* Hinweise je Mensa füllen, bevor die Liste gezeichnet wird (lib/filters/boot.ts) */}
      <script is:inline>window.speislyFilters?.refresh();</script>
      <div data-filter-empty>
        <NoMeals type="filter" />
      </div>
    </>
  )
}

<script>
  import { setSelectedMensen } from "@/stores/filters";

  document.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).closest("[data-filter-reset]")) {
      setSelectedMensen([]);
    }
  });
</script>
