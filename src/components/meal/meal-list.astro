---
/**
 * Astro-Port von meal-list.tsx. Statisches HTML für alle Besucher (cachebar);
 * die Filter wirken rein per CSS (lib/filters/boot.ts):
 *  - Mensa-Auswahl: generiertes CSS auf [data-mensa-id]
 *  - vegetarisch/vegan: html[data-diet] blendet [data-meal] ohne Flag aus.
 * Alles, was vom Ernährungsfilter abhängt (Hinweise „X Gerichte ausgeblendet“,
 * Zähler, leere Bereiche), wird hier für jede Variante vorberechnet und über
 * data-only-diet / data-hide-diet umgeschaltet. So bleibt das Markup identisch
 * zur React-Version, ohne JS und ohne Flackern.
 */
import { ChevronDown } from "@lucide/astro";
import InfoCard from "@/components/info-card.astro";
import { cn } from "@/lib/utils";
import EmptyState from "./empty-state.astro";
import MealCard from "./meal-card.astro";
import MensaHeader from "./mensa-header.astro";

type Props = {
  groups: MensaMealGroup[];
  /** angezeigter Tag (`YYYY-MM-DD`) */
  date: string;
  /** heute in Berlin (`YYYY-MM-DD`) */
  today: string;
};

type Diet = "veggie" | "vegan";
const DIETS: Diet[] = ["veggie", "vegan"];
const keeps = (meal: Meal, diet: Diet) =>
  diet === "vegan" ? Boolean(meal.flags.isVegan) : Boolean(meal.flags.isVeggie);

const { groups, date, today } = Astro.props;

const hiddenText = (n: number) =>
  `${n === 1 ? "1 Gericht wurde" : `${n} Gerichte wurden`} durch den Filter ausgeblendet.`;
const dietList = (pred: (d: Diet) => boolean) =>
  DIETS.filter(pred).join(" ") || undefined;

const prepared = groups.map((group, groupIndex) => {
  const regular = group.meals
    .filter((m) => !m.flags.isSmall)
    .sort((a, b) => b.priceStud - a.priceStud);
  const portion = group.meals.filter((m) => m.flags.isSmall);
  const stats = Object.fromEntries(
    DIETS.map((diet) => {
      const kept = group.meals.filter((m) => keeps(m, diet)).length;
      return [
        diet,
        {
          hidden: group.meals.length - kept,
          allHidden: kept === 0,
          regular: regular.filter((m) => keeps(m, diet)).length,
          portion: portion.filter((m) => keeps(m, diet)).length,
        },
      ];
    })
  ) as Record<Diet, { hidden: number; allHidden: boolean; regular: number; portion: number }>;
  return {
    group,
    regular,
    portion,
    stats,
    triggerId: `mensa-${groupIndex}-portions-trigger`,
    contentId: `mensa-${groupIndex}-portions-content`,
  };
});

const triggerClass = cn(
  "flex flex-1 items-start justify-between gap-4 rounded-md py-4 text-left font-medium text-sm outline-none transition-all hover:underline focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50 [&[data-state=open]>svg]:rotate-180",
  "group rounded-lg px-4 py-3 transition-all duration-200 hover:no-underline"
);
---

{
  groups.length === 0 ? (
    <EmptyState date={date} today={today} type="date" />
  ) : (
    <>
      <section class="container mx-auto pb-8" id="mealslist">
        {prepared.map(({ group, regular, portion, stats, triggerId, contentId }) => (
          <div data-mensa-group data-mensa-id={group.id}>
            <MensaHeader mensa={group} />
            {DIETS.filter((d) => stats[d].allHidden).map((d) => (
              <div class="py-4 pb-8" data-only-diet={d}>
                <InfoCard
                  class="mx-4 mt-4"
                  description={hiddenText(stats[d].hidden)}
                  icon="info"
                />
              </div>
            ))}
            <div class="contents" data-hide-diet={dietList((d) => stats[d].allHidden)}>
              {DIETS.filter((d) => stats[d].hidden > 0 && !stats[d].allHidden).map((d) => (
                <InfoCard
                  class="mx-4 mt-4"
                  data-only-diet={d}
                  description={hiddenText(stats[d].hidden)}
                  icon="info"
                />
              ))}
              <div class="space-y-4 pt-4 pb-4 sm:pb-16">
                {regular.length > 0 && (
                  <div
                    class="grid gap-4 px-4 md:grid-cols-2 lg:grid-cols-3"
                    data-hide-diet={dietList((d) => stats[d].regular === 0)}
                    data-last-when={
                      portion.length > 0
                        ? dietList((d) => stats[d].portion === 0)
                        : undefined
                    }
                  >
                    {regular.map((meal, index) => (
                      <MealCard meal={meal} priority={index < 3} />
                    ))}
                  </div>
                )}
                {portion.length > 0 && (
                  <div class=" " data-hide-diet={dietList((d) => stats[d].portion === 0)}>
                    <div class="w-full" data-orientation="vertical" data-slot="accordion">
                      <div
                        class={cn("border-b last:border-b-0", "border-none")}
                        data-orientation="vertical"
                        data-slot="accordion-item"
                        data-state="closed"
                      >
                        <h3 class="flex" data-orientation="vertical" data-state="closed">
                          <button
                            aria-controls={contentId}
                            aria-expanded="false"
                            class={triggerClass}
                            data-orientation="vertical"
                            data-slot="accordion-trigger"
                            data-state="closed"
                            id={triggerId}
                            type="button"
                          >
                            <div class="flex items-center gap-3">
                              <span class="font-semibold text-base text-foreground">
                                Weitere Gerichte
                              </span>
                              <span class="inline-flex size-6 items-center justify-center rounded-full bg-primary/10 font-bold text-primary text-sm">
                                <span data-hide-diet="veggie vegan">{portion.length}</span>
                                {DIETS.map((d) => (
                                  <span data-only-diet={d}>{stats[d].portion}</span>
                                ))}
                              </span>
                            </div>
                            <ChevronDown class="pointer-events-none size-4 shrink-0 translate-y-0.5 text-muted-foreground transition-transform duration-200" />
                          </button>
                        </h3>
                        <div
                          aria-labelledby={triggerId}
                          class="overflow-hidden text-sm data-[state=closed]:animate-accordion-up data-[state=open]:animate-accordion-down"
                          data-orientation="vertical"
                          data-slot="accordion-content"
                          data-state="closed"
                          hidden
                          id={contentId}
                          role="region"
                        >
                          <div class={cn("pt-0 pb-4", "px-4 py-2")}>
                            <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
                              {portion.map((meal) => (
                                <MealCard meal={meal} />
                              ))}
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                )}
              </div>
            </div>
          </div>
        ))}
      </section>
      <div data-filter-empty>
        <EmptyState type="filter" />
      </div>
    </>
  )
}

<style is:global>
  html[data-diet="veggie"] [data-meal]:not([data-veggie]),
  html[data-diet="vegan"] [data-meal]:not([data-vegan]),
  html[data-diet="veggie"] [data-hide-diet~="veggie"],
  html[data-diet="vegan"] [data-hide-diet~="vegan"] {
    display: none !important;
  }
  [data-only-diet],
  [data-filter-empty] {
    display: none;
  }
  html[data-diet="veggie"] [data-only-diet="veggie"],
  html[data-diet="vegan"] [data-only-diet="vegan"] {
    display: block;
  }
  /* space-y-4 setzt Abstände per :not(:last-child) – ein ausgeblendetes
     Accordion zählt noch als letztes Kind, daher hier korrigieren */
  html[data-diet="veggie"] [data-last-when~="veggie"],
  html[data-diet="vegan"] [data-last-when~="vegan"] {
    margin-block-end: 0 !important;
  }
</style>

<script>
  import { setSelectedMensen } from "@/stores/filters";

  // Accordion „Weitere Gerichte“ (Verhalten wie Radix, ohne React)
  function toggle(trigger: HTMLElement) {
    const item = trigger.closest<HTMLElement>('[data-slot="accordion-item"]');
    const content = item?.querySelector<HTMLElement>(
      '[data-slot="accordion-content"]'
    );
    if (!(item && content)) {
      return;
    }
    const open = trigger.dataset.state !== "open";
    const state = open ? "open" : "closed";
    if (open) {
      content.hidden = false;
    }
    content.style.setProperty(
      "--radix-accordion-content-height",
      `${content.scrollHeight}px`
    );
    for (const el of [item, item.querySelector("h3"), trigger, content]) {
      if (el) {
        (el as HTMLElement).dataset.state = state;
      }
    }
    trigger.setAttribute("aria-expanded", String(open));
    if (!open) {
      content.addEventListener(
        "animationend",
        () => {
          if (content.dataset.state === "closed") {
            content.hidden = true;
          }
        },
        { once: true }
      );
    }
  }

  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    const trigger = target.closest<HTMLElement>(
      '[data-slot="accordion-trigger"]'
    );
    if (trigger) {
      toggle(trigger);
      return;
    }
    if (target.closest("[data-filter-reset]")) {
      setSelectedMensen([]);
    }
  });
</script>
