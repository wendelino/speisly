---
// Astro-Port von meal-serving-stats.tsx (Inhalt der Server Island)
import { CalendarDays } from "@lucide/astro";
import { format } from "date-fns";
import { de } from "date-fns/locale";
import { badgeVariants } from "@/components/ui/badge";
import { isoDayToLocalDate } from "@/lib/format-day";
import { cn } from "@/lib/utils";
import type { MealServingStats } from "@/server/queries/serving-stats";

type Props = { stats: MealServingStats };
const { totalServings, mensaCount, firstServed, lastServed, byMensa } =
  Astro.props.stats;

const formatServingDate = (isoDay: string) =>
  format(isoDayToLocalDate(isoDay), "dd.MM.yyyy", { locale: de });

const items = [
  { label: "An Mensen", value: String(mensaCount) },
  ...(firstServed ? [{ label: "Erstmals", value: formatServingDate(firstServed) }] : []),
  ...(lastServed ? [{ label: "Zuletzt", value: formatServingDate(lastServed) }] : []),
];
---

<div class="relative space-y-4 rounded-lg border bg-muted p-5">
  {
    totalServings === 0 ? (
      <p class="text-center text-muted-foreground text-sm">Noch keine Angebotsdaten vorhanden</p>
    ) : (
      <>
        <span
          class={cn(badgeVariants({ variant: "default" }), "-top-2 -right-2 absolute font-semibold")}
          data-slot="badge"
        >{`${totalServings} ${totalServings === 1 ? "Angebot" : "Angebote"}`}</span>
        <div class="space-y-1 border-b pb-4">
          {items.map((item) => (
            <div class="flex items-center justify-between gap-4 py-1.5">
              <span class="text-muted-foreground text-sm">{item.label}</span>
              <span class="font-semibold text-sm tabular-nums">{item.value}</span>
            </div>
          ))}
        </div>
        <div class="space-y-3">
          <p class="flex items-center gap-1.5 font-medium text-sm"><CalendarDays class="size-4 text-muted-foreground" />Pro Mensa</p>
          <ul class="space-y-2">
            {byMensa.map((entry) => (
              <li class="flex items-start justify-between gap-4 rounded-md border bg-background px-3 py-2">
                <div class="min-w-0">
                  <p class="truncate font-medium text-sm">{entry.mensaName}</p>
                  <p class="text-muted-foreground text-xs">{`${formatServingDate(entry.firstServed)} – ${formatServingDate(entry.lastServed)}`}</p>
                </div>
                <span class="shrink-0 font-semibold text-sm tabular-nums">{`${entry.servingCount}×`}</span>
              </li>
            ))}
          </ul>
        </div>
      </>
    )
  }
</div>
