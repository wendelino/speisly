---
// Astro-Port von src/components/title.tsx (gleiche Klassen, kein JS)
import { cn } from "@/lib/utils";

type Props = {
  variant: "h1" | "h2" | "h3" | "h4";
  id?: string;
  class?: string;
  noBorder?: boolean;
};

const { variant, id, class: className, noBorder = false } = Astro.props;
const Tag = variant;
---

<Tag
  class={cn(
    "mt-16 mb-4 font-semibold",
    noBorder ? "" : "border-b pb-2",
    variant === "h1" &&
      "font-bold text-2xl leading-tight tracking-tight sm:text-4xl",
    variant === "h2" && "text-xl sm:text-2xl",
    variant === "h3" && "my-4 text-lg sm:text-xl",
    variant === "h4" && "my-2 text-base",
    className
  )}
  id={id}
>
  <slot/>
</Tag>
