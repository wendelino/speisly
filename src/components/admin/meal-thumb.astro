---
// Kleines Gerichtsbild im Admin-Bereich (vorberechnete Variante, sonst das
// Original); ohne Bild ein leeres Feld
import { cn } from "@/lib/utils";
import { images } from "@/server/images";

type Props = { src?: string | null; class?: string };
const { src, class: className } = Astro.props;
const url = src ? (images.variants(src)?.small.webp ?? src) : null;
---

<div class={cn("size-16 shrink-0 overflow-hidden rounded-xl bg-muted", className)}>
  {url && <img alt="" class="size-full object-cover" decoding="async" loading="lazy" src={url}>}
</div>
