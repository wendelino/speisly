---
// Astro-Port von day-selector.tsx: statisches Markup (identische Klassen),
// Navigation per Mini-Script. Der Kalender (react-day-picker) wird erst beim
// Öffnen geladen (calendar-popover.mount.tsx).
import { Calendar as CalendarIcon } from "@lucide/astro";
import { format } from "date-fns";
import { de } from "date-fns/locale";
import { buttonVariants } from "@/components/ui/button";
import { isoDayToLocalDate } from "@/lib/format-day";
import { cn } from "@/lib/utils";
import { addDays } from "@/server/dates";

type Props = {
  /** heute in Berlin (`YYYY-MM-DD`) */
  today: string;
  /** ausgewählter Tag (`YYYY-MM-DD`), Default: heute */
  selected?: string;
};

const { today, selected = today } = Astro.props;
const tomorrow = addDays(today, 1);
const isToday = selected === today;
const isTomorrow = selected === tomorrow;
const isCustomDate = !(isToday || isTomorrow);
const selectedDate = isoDayToLocalDate(selected);

// wie DaySelectorButton: Button-Variante + eigene Klassen
const buttonClass = (condition: boolean, className?: string) =>
  cn(
    buttonVariants({
      variant: condition ? "default" : "outline",
      className: cn(
        "h-11 min-w-16 overflow-hidden p-0 transition-all",
        className,
        condition
          ? "bg-primary text-primary-foreground shadow-md"
          : "bg-background hover:bg-muted"
      ),
    })
  );

const quick = [
  { label: "Heute", day: today, active: isToday },
  { label: "Morgen", day: tomorrow, active: isTomorrow },
];
---

<section
  class="container mx-auto px-4 py-6"
  data-selected={selected}
  id="day-selector"
>
  <div class="grid grid-cols-4 items-center justify-center gap-2">
    {
      quick.map(({ label, day, active }) => (
        <button class={buttonClass(active)} data-day-href={`/day/${day}`} data-slot="button">
          <div class="flex flex-col items-center"><span class="font-medium text-xs opacity-80">{label}</span><span class="-mt-0.5 font-bold text-sm">{format(isoDayToLocalDate(day), "dd.MM", { locale: de })}</span></div>
        </button>
      ))
    }
    <button
      aria-expanded="false"
      aria-haspopup="dialog"
      class={buttonClass(isCustomDate, "col-span-2")}
      data-calendar-trigger
      data-slot="button"
    >
      <div
        class={cn(
          "flex h-full items-center border-r px-3",
          isCustomDate ? "border-r-primary-foreground/40" : "bg-muted"
        )}
      >
        <CalendarIcon
          class={cn(
            "size-4.5",
            isCustomDate ? "text-primary-foreground/80" : "text-muted-foreground"
          )}
        />
      </div>
      <div class="flex flex-1 items-center pl-1">
        {
          isCustomDate ? (
            <div class="flex flex-col items-start"><span class="font-medium text-xs opacity-80">{format(selectedDate, "EEEE", { locale: de })}</span><span class="-mt-0.5 font-bold text-sm">{format(selectedDate, "dd.MM", { locale: de })}</span></div>
          ) : (
            <span class="font-medium text-sm">Kalender</span>
          )
        }
      </div>
    </button>
  </div>
</section>

<script>
  import { prefetch } from "astro:prefetch";

  const section = document.getElementById("day-selector");
  const loadCalendar = () => import("./calendar-popover.mount");

  for (const button of section?.querySelectorAll<HTMLElement>(
    "[data-day-href]"
  ) ?? []) {
    const href = button.dataset.dayHref as string;
    button.addEventListener("pointerenter", () => prefetch(href));
    button.addEventListener("click", () => window.location.assign(href));
  }

  const trigger = section?.querySelector<HTMLElement>("[data-calendar-trigger]");
  if (section && trigger) {
    // React + Kalender bei Nutzerabsicht vorladen, beim Klick öffnen
    for (const event of ["pointerenter", "touchstart", "focus"]) {
      trigger.addEventListener(event, loadCalendar, { once: true, passive: true });
    }
    trigger.addEventListener("click", async () => {
      const { openCalendar } = await loadCalendar();
      trigger.setAttribute("aria-expanded", "true");
      openCalendar(trigger, section.dataset.selected as string);
    });
  }
</script>
