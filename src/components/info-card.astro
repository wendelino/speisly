---
import Icon from "@/components/icons/icon.astro";
// Astro-Port von info-card.tsx
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/lib/utils";

type Props = HTMLAttributes<"div"> & {
  description: string;
  icon?: "info" | "warning" | "error" | "success";
};

const { description, icon = "info", class: className, ...rest } = Astro.props;
---

<div class={cn("", className)} {...rest}>
  <div class="flex items-center gap-2">
    {icon === "info" && <Icon class="size-4.5 text-primary" name="info" />}
    {icon === "warning" && <Icon class="h-4 w-4" name="circle-alert" />}
    {icon === "error" && <Icon class="h-4 w-4" name="triangle-alert" />}
    {icon === "success" && <Icon class="h-4 w-4" name="circle-check" />}
    <p class="text-muted-foreground text-sm">{description}</p>
  </div>
</div>
