---
// Icon in einer organischen Blob-Form, z. B. über Seitentiteln und leeren Zuständen
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/lib/utils";
import { TONES, type Tone } from "./tones";

type Props = HTMLAttributes<"div"> & {
  tone?: Tone;
  size?: "sm" | "md" | "lg";
  /** sanftes Schweben (respektiert prefers-reduced-motion) */
  float?: boolean;
};

const {
  tone = "primary",
  size = "md",
  float = false,
  class: className,
  ...rest
} = Astro.props;
const SIZES = {
  sm: "size-12 [&_svg]:size-6",
  md: "size-16 [&_svg]:size-8",
  lg: "size-24 [&_svg]:size-11",
};
---

<div
  aria-hidden="true"
  class={cn(
    "relative inline-flex shrink-0 items-center justify-center rounded-[42%_58%_63%_37%/41%_44%_56%_59%]",
    TONES[tone].soft,
    TONES[tone].text,
    SIZES[size],
    float && "animate-float",
    className
  )}
  {...rest}
>
  <slot />
</div>
