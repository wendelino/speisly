---
// Leerer Zustand: schwebendes Icon (slot "icon"), Titel, Text, Aktionen (default slot)
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/lib/utils";
import IconBlob from "./icon-blob.astro";
import type { Tone } from "./tones";

type Props = HTMLAttributes<"div"> & {
  title: string;
  description?: string;
  tone?: Tone;
  headingLevel?: "h1" | "h2" | "h3";
};

const {
  title,
  description,
  tone = "peach",
  headingLevel: Heading = "h2",
  class: className,
  ...rest
} = Astro.props;
---

<div
  class={cn("flex flex-col items-center px-4 py-16 text-center", className)}
  {...rest}
>
  <div class="relative mb-6">
    <div class="absolute inset-0 scale-150 rounded-full bg-secondary/60 blur-2xl"></div>
    <IconBlob class="relative" float size="lg" tone={tone}>
      <slot name="icon" />
    </IconBlob>
  </div>
  <Heading class="font-bold text-2xl sm:text-3xl">{title}</Heading>
  {description && <p class="mt-2 max-w-sm text-muted-foreground">{description}</p>}
  <div class="mt-6 flex flex-wrap justify-center gap-3 empty:hidden"><slot /></div>
</div>
