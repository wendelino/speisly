---
// Typografie für lange Texte (z. B. Datenschutz): Überschriften, Absätze, Listen
import { cn } from "@/lib/utils";

type Props = { class?: string };
const { class: className } = Astro.props;
---

<div class={cn("prose-speisly", className)}><slot /></div>

<style is:global>
  @reference "../../styles/globals.css";

  .prose-speisly {
    @apply text-[0.95rem] text-foreground/90 leading-relaxed sm:text-base;
  }
  .prose-speisly :where(section + section) {
    @apply mt-6 border-border/70 border-t pt-6;
  }
  .prose-speisly :where(h2) {
    @apply mb-3 font-bold font-display text-xl sm:text-2xl;
  }
  .prose-speisly :where(h3) {
    @apply mt-6 mb-2 font-display font-semibold text-lg;
  }
  .prose-speisly :where(h4) {
    @apply mt-4 mb-1.5 font-semibold text-base;
  }
  .prose-speisly :where(p) {
    @apply my-3;
  }
  .prose-speisly :where(ul) {
    @apply my-3 space-y-1.5 text-sm;
  }
  .prose-speisly :where(li) {
    @apply relative pl-5;
  }
  .prose-speisly :where(li)::before {
    @apply absolute top-[0.6em] left-1 size-1.5 rounded-full bg-primary/60 content-[""];
  }
  .prose-speisly :where(a) {
    @apply font-semibold text-primary underline-offset-4 hover:underline;
  }
  .prose-speisly :where(strong) {
    @apply font-semibold text-foreground;
  }
  .prose-speisly :where(.muted) {
    @apply text-muted-foreground text-sm;
  }
</style>
