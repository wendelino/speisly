---
// Formularfeld: Beschriftung, Eingabe (Slot, braucht id und
// aria-describedby="<id>-error") und Platz für die Fehlermeldung
import { cn } from "@/lib/utils";
import { labelClass } from "./variants";

type Props = { id: string; label: string; class?: string };
const { id, label, class: className } = Astro.props;
---

<div class={cn("space-y-2", className)}>
  <label class={labelClass} for={id}>{label}</label>
  <slot />
  <p class="font-medium text-destructive text-sm" hidden id={`${id}-error`}></p>
</div>
