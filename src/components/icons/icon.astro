---
// Icon aus dem SVG-Sprite (icon-sprite.astro) statt eines kompletten Inline-SVGs:
// ~110 statt ~400 Byte pro Icon. Die Lucide-Standardattribute (fill, stroke …)
// setzt `.ic` in globals.css in @layer base, damit Klassen wie
// `fill-yellow-400` sie wie bisher überschreiben.
// Voraussetzung: Die Seite bindet den Sprite ein (BaseLayout `mealAssets`), und
// das Icon hat eine Größenklasse (size-4, h-5 w-5 …): Ohne width/height/viewBox
// am äußeren SVG skaliert der viewBox des Symbols auf diese Größe.
import type { HTMLAttributes } from "astro/types";
import type { SpriteIconName } from "./sprite-icons";

type Props = HTMLAttributes<"svg"> & { name: SpriteIconName };
const { name, class: className, ...rest } = Astro.props;
---

<svg aria-hidden="true" class:list={["ic", className]} {...rest}><use href={`#i-${name}`}></use></svg>
