---
// Begrüßung über dem Speiseplan: Datum und „Was gibt’s heute?“ mit
// Kringel-Unterstreichung. Deko-Illustration (schwebendes Essen) nur ab sm.
import { format } from "date-fns";
import { de } from "date-fns/locale";
import { isoDayToLocalDate } from "@/lib/format-day";
import { diffDays } from "@/server/dates";
// eigene Datei statt Inline-SVG: hält das HTML klein, mobil wird sie nicht geladen
import decorUrl from "@/assets/hero-decor.svg?url&no-inline";

type Props = {
  /** heute in Berlin (`YYYY-MM-DD`) */
  today: string;
  /** angezeigter Tag (`YYYY-MM-DD`) */
  date: string;
};

const { today, date } = Astro.props;
const diff = diffDays(today, date);
const local = isoDayToLocalDate(date);
const verb = diff < 0 ? "Was gab’s" : "Was gibt’s";
const RELATIVE: Record<number, string> = {
  [-1]: "gestern",
  0: "heute",
  1: "morgen",
};
const word =
  RELATIVE[diff] ??
  (Math.abs(diff) < 7
    ? format(local, "EEEE", { locale: de })
    : format(local, "dd.MM.", { locale: de }));
const prefix = diff in RELATIVE ? "" : "am ";
---

<section class="container-page relative pt-2 pb-5 sm:pt-6 sm:pb-8">
  <div aria-hidden="true" class="-z-10 pointer-events-none absolute inset-0">
    <div class="-top-16 absolute right-[-4rem] size-64 rounded-full bg-secondary opacity-80 blur-3xl sm:right-10"></div>
    <div class="absolute top-10 left-[-5rem] size-56 rounded-full bg-sun-soft opacity-70 blur-3xl"></div>
  </div>
  <p class="font-semibold text-muted-foreground text-sm uppercase tracking-wider">
    {format(local, "EEEE, d. MMMM", { locale: de })}
  </p>
  <h1 class="mt-1 font-extrabold text-4xl leading-tight sm:text-6xl">
    {`${verb} ${prefix}`}<span class="relative inline-block whitespace-nowrap text-primary">{word}<svg aria-hidden="true" class="-bottom-1.5 sm:-bottom-2 absolute left-0 h-2.5 w-full text-gold sm:h-3.5" fill="none" preserveAspectRatio="none" viewBox="0 0 120 12"><path d="M2 8c10-6 18-6 28 0s18 6 28 0 18-6 28 0 18 6 30-1" stroke="currentColor" stroke-linecap="round" stroke-width="4"></path></svg></span>?
  </h1>
  <p class="mt-3 max-w-md text-muted-foreground sm:text-lg">
    Alle Mensen in Halle auf einen Blick – such dir was Leckeres aus.
  </p>
  <img
    alt=""
    class="pointer-events-none absolute top-2 right-6 hidden h-31 w-auto sm:block lg:right-10"
    decoding="async"
    height="124"
    loading="lazy"
    src={decorUrl}
    width="250"
  >
</section>
