---
// Fußzeile: Wellenkante, Marke, Links und Feedback-Aufruf. Kein Client-JS.
import { Heart, MessageCircleHeart } from "@lucide/astro";
import Button from "@/components/ui/button.astro";

const LINKS = [
  { href: "/", label: "Speiseplan" },
  { href: "/kontakt", label: "Kontakt" },
  { href: "/feedback", label: "Feedback" },
  { href: "/datenschutz", label: "Datenschutz" },
];
---

<footer class="relative mt-20 bg-secondary/70 text-sm">
  <svg
    aria-hidden="true"
    class="-top-6 absolute inset-x-0 h-6 w-full text-secondary/70"
    preserveAspectRatio="none"
    viewBox="0 0 1200 24"
  >
    <path
      d="M0 24V12C100 0 200 0 300 12s200 12 300 0 200-12 300 0 200 12 300 0v12Z"
      fill="currentColor"
    ></path>
  </svg>
  <div class="container-page grid gap-10 py-12 md:grid-cols-[1.2fr_1fr_1.2fr] md:items-start">
    <div class="space-y-3">
      <a class="inline-flex items-center gap-2.5" href="/">
        <img
          alt=""
          class="size-10 rounded-[0.6rem] shadow-soft"
          decoding="async"
          height="40"
          loading="lazy"
          src="/logo-96.png"
          width="40"
        >
        <span class="font-bold font-display text-xl">
          Speisly<span class="text-primary">.de</span>
        </span>
      </a>
      <p class="max-w-xs text-muted-foreground leading-relaxed">
        Die Speisepläne der Mensen in Halle – schnell, übersichtlich und mit
        euren Bewertungen.
      </p>
    </div>

    <nav aria-label="Fußzeile">
      <ul class="grid grid-cols-2 gap-x-6 gap-y-2.5">
        {
          LINKS.map((link) => (
            <li>
              <a
                class="font-medium text-foreground/80 underline-offset-4 transition-colors hover:text-primary hover:underline"
                href={link.href}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="rounded-3xl bg-card p-5 shadow-soft ring-1 ring-border/60">
      <p class="font-bold font-display text-base">Fehlt dir was?</p>
      <p class="mt-1 text-muted-foreground">
        Speisly ist noch in Entwicklung und wird ständig besser. Wir freuen uns
        über jede Idee!
      </p>
      <Button class="mt-4" href="/feedback" size="sm" variant="secondary">
        <MessageCircleHeart class="size-4" />
        Feedback geben
      </Button>
    </div>
  </div>
  <div class="border-border/70 border-t">
    <p class="container-page flex flex-wrap items-center justify-center gap-1.5 py-5 text-muted-foreground text-xs">
      <span>{`© ${new Date().getFullYear()} Speisly`}</span>
      <span aria-hidden="true">·</span>
      <span class="inline-flex items-center gap-1">
        Mit <Heart class="size-3.5 fill-primary text-primary" /><span class="sr-only">Liebe</span> für die Studis in Halle
      </span>
    </p>
  </div>
</footer>
