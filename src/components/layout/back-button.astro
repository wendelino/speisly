---

// Astro-Port von back-button.tsx: Link mit History-Back per Mini-Script
import { ArrowLeft } from "@lucide/astro";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";

type Props = {
  href?: string;
  label?: string;
  class?: string;
};

const { href = "/", label = "Zurück", class: className } = Astro.props;
---

<a
  class={cn(
    buttonVariants({ variant: "ghost", className: cn("text-primary", className) })
  )}
  data-back-button
  data-slot="button"
  href={href}
>
  <ArrowLeft class="h-4 w-4" />
  {label}
</a>

<script>
  // Wie vorher router.back(): zurück, wenn es eine History gibt, sonst href
  for (const link of document.querySelectorAll<HTMLAnchorElement>(
    "[data-back-button]"
  )) {
    link.addEventListener("click", (event) => {
      if (window.history.length > 1) {
        event.preventDefault();
        window.history.back();
      }
    });
  }
</script>
