---
// Zurück-Link: geht in der History zurück, wenn es eine gibt, sonst zu `href`
import { ArrowLeft } from "@lucide/astro";
import Button from "@/components/ui/button.astro";

type Props = { href?: string; label?: string; class?: string };
const { href = "/", label = "Zurück", class: className } = Astro.props;
---

<Button class={className} data-back-button href={href} size="sm" variant="outline">
  <ArrowLeft class="size-4" />
  {label}
</Button>

<script>
  for (const link of document.querySelectorAll<HTMLAnchorElement>(
    "[data-back-button]"
  )) {
    link.addEventListener("click", (event) => {
      if (window.history.length > 1) {
        event.preventDefault();
        window.history.back();
      }
    });
  }
</script>
