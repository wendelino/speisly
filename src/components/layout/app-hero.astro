---

// Astro-Port von app-hero.tsx (AppHeroVariant)
import Title from "@/components/astro/title.astro";
---

<div
  class="bg-linear-to-b from-primary/40 to-transparent p-4 py-16 pt-8 md:py-32"
>
  <div
    class="mx-auto flex max-w-lg items-center gap-5 rounded-2xl bg-background p-5"
  >
    <div class="shrink-0">
      <img
        alt="Speisly Logo"
        class="w-16 rounded-xl shadow-md sm:w-24"
        decoding="async"
        fetchpriority="high"
        height="96"
        src="/logo_full.png"
        width="96"
      >
    </div>
    <div class="flex-1">
      <Title class="my-0 sm:mb-1" noBorder variant="h1">
        Speisly<span class="text-primary">.de</span>
      </Title>
      <p class="text-lg text-muted-foreground sm:text-xl">
        Interaktiver Speiseplan
      </p>
    </div>
  </div>
</div>
