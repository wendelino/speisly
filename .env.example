# Alle Werte liest der Server erst beim Start (nicht beim Build), Regeln und
# Bedeutung: env-schema.mjs. Fehlt eine Pflichtangabe, startet er nicht
# (Exit-Code 1). Optionale Dienste sind ohne ihre Werte abgeschaltet.

# --- Pflicht ---------------------------------------------------------------

# Öffentliche Basis-URL. Lokal: http://localhost:4321, sonst die der Umgebung
SITE_URL=https://example.org

# Datenbank
DATABASE_URL=postgresql://user:password@localhost:5432/speisly

# API & Sync
API_BEARER_TOKEN=your-secret-bearer-token
# Basis-URL der Speiseplan-API (privat, nicht ins Repo)
MEINE_MENSA_API_URL=https://api.example.org/api
# Nur Bilder unter dieser URL lädt der Sync (Mediathek der Speiseplan-API)
IMAGE_SOURCE_URL=https://images.example.org/mediathek/
# Link „Inhaltsstoffe und Allergene“ auf der Detailseite
ALLERGEN_INFO_URL=https://example.org/allergene

# JWT (Nutzer-Cookie)
JWT_SECRET=your-jwt-secret-key
JWT_ALGORITHM=HS256

# --- Optional --------------------------------------------------------------

# Bildvarianten der Gerichtsbilder (beim Sync erzeugt, persistentes Volume)
IMAGE_DIR=./data/img

# Admin-Bereich /admin: Login über OIDC, nur Gruppe ADMIN_GROUP. Ohne Issuer,
# Client-ID und Secret abgeschaltet. Beim Provider eintragen: Redirect-URI
# <SITE_URL>/admin/callback, Post-Logout-URI <SITE_URL>/
OIDC_ISSUER=https://sso.example.org
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
ADMIN_GROUP=speisly-admin

# Web-Push für Favoriten und Admin-Meldungen: `bunx web-push generate-vapid-keys`.
# Den öffentlichen Schlüssel gibt der Server im HTML an den Browser weiter.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontakt für Push-Dienste (mailto: oder https:), Default: SITE_URL
VAPID_SUBJECT=

# Analytics (Umami, nur im Production-Build, zählt nur auf dem Host von SITE_URL)
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Server (server/index.mjs)
HOST=0.0.0.0
PORT=4321
# 1 = kein Cron und kein Pre-Warm (z. B. zweite Instanz)
CRON_DISABLED=

# --- Beim Build ------------------------------------------------------------

# Server Islands: stabiler Schlüssel für verschlüsselte Island-Props, die
# einzige Angabe, die der Build liest (`bunx astro create-key`)
ASTRO_KEY=
