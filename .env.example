# Datenbank
DATABASE_URL=postgresql://user:password@localhost:5432/speisly

# Cookie & Privacy (öffentlich, landen im Client-Bundle)
PUBLIC_COOKIE_CONSENT_NAME=speisly-cookie-consent
PUBLIC_PRIVACY_POLICY_PATH=/datenschutz

# API & Sync
API_BEARER_TOKEN=your-secret-bearer-token

# JWT
JWT_SECRET=your-jwt-secret-key
JWT_ALGORITHM=HS256

# Bildvarianten der Gerichtsbilder (beim Sync erzeugt, persistentes Volume)
IMAGE_DIR=./data/img

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Server Islands: stabiler Schlüssel für verschlüsselte Island-Props, wird beim
# BUILD gelesen (`bunx astro create-key`)
ASTRO_KEY=

# Server (server/index.mjs)
HOST=0.0.0.0
PORT=4321
# 1 = kein Cron und kein Pre-Warm (z. B. zweite Instanz)
CRON_DISABLED=
