{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/core", "ultracite/react", "ultracite/astro"],
  // Von drizzle-kit erzeugt
  "files": { "includes": ["**", "!drizzle"] },
  "linter": {
    "rules": {
      "style": {
        "noNestedTernary": "off",
        "noNonNullAssertion": "off"
      },
      "correctness": {
        "noUnusedVariables": "warn"
      },
      "a11y": {
        "useKeyWithClickEvents": "off"
      },
      "nursery": {
        "useSortedClasses": "info"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "options": {
            "maxAllowedComplexity": 30
          }
        },
        "noUselessFragments": "info"
      }
    }
  },
  "overrides": [
    {
      // Der Formatter entfernt in .astro-Templates Leerzeichen um {Ausdrücke}
      // und Inline-Elemente („<b>fett</b> danach“ → „<b>fett</b>danach“) und
      // verändert so den gerenderten Text. Außerdem fügt jedes `check/lint
      // --write` (auch fixAll beim Speichern im Editor) eine Leerzeile ins
      // Frontmatter ein (Biome 2.3.8). Typprüfung übernimmt `astro check`.
      "includes": ["**/*.astro"],
      "formatter": { "enabled": false },
      "assist": { "enabled": false },
      "linter": { "enabled": false }
    }
  ]
}
