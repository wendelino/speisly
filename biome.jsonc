{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/core",
    "ultracite/react",
    "ultracite/next",
    "ultracite/astro",
    "ultracite/remix"
  ],
  "linter": {
    "rules": {
      "style": {
        "noNestedTernary": "off",
        "noNonNullAssertion": "off"
      },
      "correctness": {
        "noUnusedVariables": "warn"
      },
      "a11y": {
        "useKeyWithClickEvents": "off"
      },
      "nursery": {
        "useSortedClasses": "info"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "options": {
            "maxAllowedComplexity": 30
          }
        },
        "noUselessFragments": "info"
      }
    }
  },
  "overrides": [
    {
      // Der Formatter entfernt in .astro-Templates Leerzeichen um {Ausdrücke}
      // und Inline-Elemente („<b>fett</b> danach“ → „<b>fett</b>danach“) und
      // verändert so den gerenderten Text. Linting bleibt aktiv.
      "includes": ["**/*.astro"],
      "formatter": { "enabled": false }
    }
  ]
}
